PORT=5000
MONGODB_URI=mongodb://localhost:27017/ca-office
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development
UPLOAD_DIR=uploads

# OpenRouter (used for Expense AI + Tax Notice AI)
OPENROUTER_API_KEY=
OPENROUTER_EXPENSE_MODEL=openai/gpt-4o-mini
OPENROUTER_EXPENSE_INSIGHTS_MODEL=openai/gpt-4o-mini
OPENROUTER_TAX_MODEL=openai/gpt-4o-mini

# Google Vision OCR (direct env key method - no JSON file needed)
GOOGLE_VISION_CLIENT_EMAIL=
GOOGLE_VISION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Optional fallback (if Vision-specific values not set)
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Optional (legacy/other AI modules)
GEMINI_API_KEY=
