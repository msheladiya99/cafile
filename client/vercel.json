{
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "mycafile.in"
                }
            ],
            "destination": "https://www.mycafile.in/$1",
            "permanent": true
        },
        {
            "source": "/gst-management-software",
            "destination": "/gst-software-india",
            "permanent": true
        },
        {
            "source": "/gst-management-software/",
            "destination": "/gst-software-india",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/admin",
            "destination": "/index.html"
        },
        {
            "source": "/admin/(.*)",
            "destination": "/index.html"
        },
        {
            "source": "/super-admin",
            "destination": "/index.html"
        },
        {
            "source": "/super-admin/(.*)",
            "destination": "/index.html"
        },
        {
            "source": "/superadmin",
            "destination": "/index.html"
        },
        {
            "source": "/superadmin/(.*)",
            "destination": "/index.html"
        },
        {
            "source": "/super_admin",
            "destination": "/index.html"
        },
        {
            "source": "/super_admin/(.*)",
            "destination": "/index.html"
        },
        {
            "source": "/client",
            "destination": "/index.html"
        },
        {
            "source": "/client/(.*)",
            "destination": "/index.html"
        },
        {
            "source": "/login",
            "destination": "/index.html"
        },
        {
            "source": "/(pricing|about|careers|contact|press|privacy-policy|terms-of-service|gst-software-india|itr-filing-software|ca-practice-management|ca-office-management-software|ca-billing-software)",
            "destination": "/index.html"
        }
    ]
}
